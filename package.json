{
  "name": "joernberkefeld-com-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling host for the joernberkefeld.com Jekyll site — local serve/build scripts only. Not a publishable package.",
  "type": "module",
  "author": "Joern Berkefeld <joern.berkefeld@gmail.com>",
  "license": "MIT",
  "scripts": {
    "serve": "bundle exec jekyll serve --source \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com\" --destination \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com/_site\" --port 4000 --host 127.0.0.1 --no-watch",
    "serve:live": "bundle exec jekyll serve --source \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com\" --destination \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com/_site\" --port 4000 --host 127.0.0.1 --livereload",
    "build": "bundle exec jekyll build --source \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com\" --destination \"c:/EDF/Git/sfmc-amscript-language/joernberkefeld.com/_site\""
  }
}
