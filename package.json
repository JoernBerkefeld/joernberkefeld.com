{
  "name": "joernberkefeld-com-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling host for the joernberkefeld.com Jekyll site — local serve/build scripts only. Not a publishable package.",
  "type": "module",
  "author": "Joern Berkefeld <joern.berkefeld@gmail.com>",
  "license": "MIT",
  "scripts": {
    "serve": "bundle exec jekyll serve --source . --destination ./_site --port 4000 --host 127.0.0.1 --no-watch",
    "serve:live": "bundle exec jekyll serve --source . --destination ./_site --port 4000 --host 127.0.0.1 --livereload",
    "serve:stop": "node scripts/serve-stop.mjs",
    "build": "bundle exec jekyll build --source . --destination ./_site",
    "test": "node --test \"tests/**/*.test.cjs\""
  }
}
